<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фаза 1: Direct LLM API (OpenRouter / OpenCode Zen, OpenAI-совместимые). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Доступ ко всем файлам: агент работает с обычными путями (/sdcard/...) через java.io.File.
         Запрашивается из настроек (Папка → доступ); без него — только внутренняя папка и SAF. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- OTA-обновления через GitHub Releases (та же система, что в metro-launcher). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:theme="@style/Theme.App" android:label="Merta">
        <activity android:name=".MertaActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
